OAUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
OAUTH_AUTHORIZATION_PASSWORD=generate-a-separate-password-with-at-least-12-characters
KV_REST_API_URL=https://your-kv-rest-endpoint
KV_REST_API_TOKEN=your-kv-rest-token
# Native Upstash integrations may inject these names instead:
# UPSTASH_REDIS_REST_URL=https://your-upstash-rest-endpoint
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# MCP_RESOURCE_URL=https://custom-domain.example.com
